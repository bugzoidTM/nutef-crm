# Nutef CRM — STAGING — modelo do .env
#
# O arquivo REAL vive fora do repositório, em /root/nutef-crm-deploy/staging/.env
# (modo 600), e é gerado por `bash nutef/staging/deploy.sh init` — que preenche
# todo segredo com `openssl rand` e NUNCA sobrescreve valor já existente.
# Este modelo existe para documentar o contrato; não o copie à mão.
#
# As chaves são as mesmas do `.env.hostgator.example` do upstream (é ele quem
# o app lê, via env_file), mais o bloco SB_* que só o stack do Supabase usa.
#
# ⚠️ `${VAR}` abaixo é NOTAÇÃO deste modelo: env_file do Docker NÃO interpola.
# O init grava os valores já resolvidos, literais.

# ── Identidade (Fase 0 do PRD) — semente e piso de rollback; o banco manda depois
APP_NAME=Nutef CRM
APP_ACCENT_HEX=#1f7a3d
APP_LOGO_URL=
SUPPORT_EMAIL=
APP_LOCALE=pt-BR

# ── Domínios
APP_DOMAIN=crm-staging.nutef.com
SB_DOMAIN=supabase-crm-staging.nutef.com
DOMAIN=${APP_DOMAIN}
NEXT_PUBLIC_APP_URL=https://${APP_DOMAIN}
WAHA_WEBHOOK_BASE_URL=https://${APP_DOMAIN}

# ── Onde o deploy.sh guarda arquivos montados nos contêineres
DEPLOY_DIR=/root/nutef-crm-deploy/staging

# ── Imagens (por NÚMERO, nunca por tag móvel — doutrina de packaging do upstream)
# (${IMG_NS} = o namespace de hostgator-setup-kit/_common.sh; o init resolve)
APP_IMAGE=${IMG_NS}/deskcommcrm:1.35.0
WORKER_IMAGE=${IMG_NS}/deskcomm-worker:1.35.0
SCHEDULER_IMAGE=${IMG_NS}/deskcomm-scheduler:1.35.0
WAHA_IMAGE=devlikeapro/waha:latest-2026.7.2

# ── Supabase dedicado (stack nutefcrm-sb) — gerados pelo init
SB_POSTGRES_PASSWORD=
SB_JWT_SECRET=
SB_SECRET_KEY_BASE=
SB_ANON_KEY=
SB_SERVICE_ROLE_KEY=
SB_DASHBOARD_USERNAME=nutef
SB_DASHBOARD_PASSWORD=

# ── O que o app lê do Supabase (derivado do bloco acima)
NEXT_PUBLIC_SUPABASE_URL=https://${SB_DOMAIN}
NEXT_PUBLIC_SUPABASE_ANON_KEY=${SB_ANON_KEY}
SUPABASE_SERVICE_ROLE_KEY=${SB_SERVICE_ROLE_KEY}
SUPABASE_DB_URL=postgres://postgres:${SB_POSTGRES_PASSWORD}@crm-sb-db:5432/postgres

# ── Segredos do app — gerados pelo init
INTERNAL_SECRET=
INTERNAL_CRON_SECRET=
CPF_ENCRYPTION_KEY=
AI_CRED_AES_KEY=
WAHA_BYO_ENCRYPTION_KEY=
IMPERSONATE_COOKIE_SECRET=
LGPD_SIGNING_KEY=
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=

# ── WAHA
WAHA_API_BASE_URL=http://waha:3000
WAHA_API_KEY=
WAHA_API_KEY_SHA512=
WAHA_HMAC_SECRET=
WAHA_WEBHOOK_REQUIRE_SIGNATURE=true
WHATSAPP_DEFAULT_ENGINE=NOWEB

# ── Redis (serverless-redis-http na frente do redis efêmero)
SRH_TOKEN=
UPSTASH_REDIS_REST_URL=http://srh:80
UPSTASH_REDIS_REST_TOKEN=${SRH_TOKEN}

# ── IA — vazio de propósito: a chave entra pela tela (IA › Credenciais), cifrada no banco
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
AI_GATEWAY_API_KEY=

# ── Opcionais que ficam AUSENTES no staging (é o estado real de um 1º deploy)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SENTRY_DSN=off
NUVEMSHOP_ENABLED=false
INTERNAL_AGENT_RUN_STUB=false
NODE_ENV=production

# ── Dono (bootstrap) — usado uma vez por `deploy.sh schema`
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_ORG_NAME=Nutef
